{
  "appId": "com.charisna.moneymanagement",
  "appName": "CHARISNA Money Management",
  "webDir": "www",
  "backgroundColor": "#7558ff",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#7558ff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#7558ff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
