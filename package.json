{
  "name": "charisna-money-management-android",
  "version": "14.1.2",
  "private": true,
  "description": "Android wrapper for CHARISNA Money Management v14.1.2 Multi-User + Transfer + Cloud Sync + Universal Modals",
  "scripts": {
    "sync": "cap sync android",
    "sync:platforms": "node scripts/sync-platforms.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/share": "6.0.4",
    "@capacitor/splash-screen": "6.0.4",
    "@capacitor/status-bar": "6.0.3",
    "@supabase/supabase-js": "2.52.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ind": "1.0.0",
    "chart.js": "4.4.9",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "tesseract.js": "5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1"
  }
