{
  "name": "charisna-money-management-desktop",
  "version": "14.1.1",
  "private": true,
  "description": "CHARISNA Money Management v14.1.1 desktop app with multi-user financial spaces, cross-profile transfers, and automatic PIN unlock",
  "main": "main.cjs",
  "author": "CHARISNA",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.charisna.moneymanagement.desktop",
    "productName": "CHARISNA Money Management",
    "copyright": "Copyright © 2026 CHARISNA",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CHARISNA-Money-Management-Setup-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CHARISNA Money Management",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://charisna-money.netlify.app/desktop-updates/windows"
      }
    ]
  }
}
